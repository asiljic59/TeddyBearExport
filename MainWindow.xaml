<Window Icon="/teddy.ico" 
    x:Class="TeddyBearExport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TeddyBearExport"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="TeddyBearExport" Height="500" Width="500">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/teddy.jpg" Stretch="UniformToFill"/>
        </Grid.Background>
        
        <StackPanel
            Background="#AAFFFFFF"
            Margin="20"
            VerticalAlignment="Center"
            HorizontalAlignment="Stretch"
            Orientation="Vertical">

            <!-- Header -->
            <TextBlock
                Text="Teddy Bear Export"
                FontWeight="Bold"
                FontSize="22"
                Foreground="#333333"
                Margin="0,10,0,30"
                TextAlignment="Center" />

            <!-- One main button with context menu -->
            <Button
                x:Name="btnJsonToPdf"
                Content="JSON u PDF"
                Style="{StaticResource MainButton}"
                Width="250"
                Height="45"
                Click="BtnJsonToPdf_Click" Margin="10,10,10,0">
                <Button.ContextMenu>
                    <ContextMenu x:Name="exportContextMenu">
                        <MenuItem Header="Iz Woodometer aplikacije" Click="Button_Woodometer_Click"/>
                        <MenuItem Header="Iz Doznaka+ aplikacije" Click="Button_Doznaka_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <!-- Convert Button -->
            <Button
                Content="Prebaci TXT u Access Bazu"
                Click="RunTransfer_Click"
                Style="{StaticResource CommonButton}"
                Width="250"
                Height="45"
                Margin="0,20,0,20" />

        </StackPanel>
    </Grid>
</Window>
